# Existing Lark/NestJS backend
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
OSS_CONFIG_ENCRYPTION_KEY=replace-with-a-random-secret

# Cloudflare Worker secrets are configured with:
# pnpm exec wrangler secret put VIEW_HASH_SECRET
# pnpm exec wrangler secret put CF_ACCESS_AUD
# pnpm exec wrangler secret put CF_ACCESS_TEAM_DOMAIN

# Frontend
# Leave empty when the Worker and frontend share the same origin.
VITE_API_BASE_URL=
